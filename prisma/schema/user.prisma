model User {
  id           String        @id @default(uuid())
  name         String        @db.VarChar(255)
  email        String        @unique
  password     String
  activeStatus ActiveStatus  @default(ACTIVE)
  role         Role          @default(USER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  profile      Profile?
  post         post[]
  comments     comments[]
  subscription Subscription?

  @@map("users")
}
